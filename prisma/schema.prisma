// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             Int          @id @default(autoincrement())
  username       String       @unique
  password       String?
  googleId       String?      @unique
  email          String?      @unique
  googleName     String?
  avatar         String?
  characterName  String?
  characterClass String?
  lastLoginAt    DateTime?
  lastSeenAt     DateTime?
  isAdmin        Boolean      @default(false)
  bannedUntil    DateTime?
  banReason      String?
  createdAt      DateTime     @default(now())
  stats          Stats?
  houseMember    HouseMember?
  inventory      Inventory[]
  listings       Listing[]
  userSkills     UserSkill[]
  combatSession  CombatSession?
  activityLogs   ActivityLog[]
  loginEvents    LoginEvent[]
  feedback       Feedback[]
}

// ─── Admin / moderation ───────────────────────────────────────────────────────

model LoginEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String   // 'login' | 'logout' | 'kicked'
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([ip])
}

model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  adminId      Int
  adminName    String
  action       String
  targetUserId Int?
  details      String   // JSON: { before, after, ... }
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  category  String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
}

model Announcement {
  id        Int       @id @default(autoincrement())
  message   String
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  category  String   // 'training' | 'raid' | 'monster' | 'inventory' | 'level' | 'status' | 'travel'
  message   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Stats {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user User @relation(fields: [userId], references: [id])

  level      Int @default(1)
  xp         Int @default(0)
  statPoints Int @default(0)

  strength     Int @default(0)
  defense      Int @default(0)
  speed        Int @default(0)
  dexterity    Int @default(0)
  intelligence Int @default(0)

  health    Int @default(100)
  maxHealth Int @default(100)
  energy    Int @default(100)
  maxEnergy Int @default(100)

  gold Int @default(0)

  hasWagon  Boolean @default(false)
  wagonTier Int @default(0)
  currentCityId String?

  // NEW — travel in progress
  travelDestinationId String?
  travelArrivalAt     DateTime?

  // Real, server-tracked travel — travelArrivesAt is the source of truth for
  // when a journey actually completes. Client UI only ever displays what the
  // server reports; it never decides arrival on its own.
  travelDestination String?
  travelStartedAt   DateTime?
  travelArrivesAt   DateTime?

  lastStrengthTrain DateTime?
  lastDefenseTrain  DateTime?
  lastSpeedTrain    DateTime?
  lastDexTrain      DateTime?

  inJail        Boolean   @default(false)
  jailUntil     DateTime?
  inHospital    Boolean   @default(false)
  hospitalUntil DateTime?
  lastEnergyAt  DateTime?

  lastRaidVillageAt  DateTime?
  lastRaidCaravanAt  DateTime?
  lastRaidManorAt    DateTime?
  lastRaidTreasuryAt DateTime?
}

model UserSkill {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  skillKey   String
  unlockedAt DateTime @default(now())

  @@unique([userId, skillKey])
}

model House {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  motto     String        @default("Strength through unity.")
  gold      Int           @default(0)
  leaderId  Int           @unique
  createdAt DateTime      @default(now())
  members   HouseMember[]
}

model HouseMember {
  id      Int    @id @default(autoincrement())
  userId  Int    @unique
  houseId Int
  rank    String @default("Bannerman")
  user    User   @relation(fields: [userId], references: [id])
  house   House  @relation(fields: [houseId], references: [id])
}

model Item {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  type        String
  effect      String
  basePrice   Int
  icon        String      @default("/assets/items/_fallback/default-item.png")
  listings    Listing[]
  inventory   Inventory[]
}

model Inventory {
  id       Int  @id @default(autoincrement())
  userId   Int
  itemId   Int
  quantity Int  @default(1)
  user     User @relation(fields: [userId], references: [id])
  item     Item @relation(fields: [itemId], references: [id])
}

model Listing {
  id        Int      @id @default(autoincrement())
  sellerId  Int
  itemId    Int
  price     Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  expiresAt DateTime // after this the listing comes down and the items go back to the seller
  seller    User     @relation(fields: [sellerId], references: [id])
  item      Item     @relation(fields: [itemId], references: [id])

  @@index([expiresAt])
}

model CombatSession {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id])

  zoneId           String
  monsterName      String
  monsterLevel     Int
  monsterMaxHealth Int
  monsterHealth    Int
  monsterAttack    Int
  monsterDefense   Int

  turnCount        Int      @default(0)
  createdAt        DateTime @default(now())
}

// Hourly per-player gold snapshots (pruned after 14 days). Powers the admin
// economy view: gold in circulation over time and biggest recent gold gains.
model GoldSnapshot {
  id      Int      @id @default(autoincrement())
  userId  Int
  gold    Int
  takenAt DateTime

  @@index([takenAt])
  @@index([userId, takenAt])
}
