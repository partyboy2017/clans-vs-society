// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             Int          @id @default(autoincrement())
  username       String       @unique
  password       String?
  googleId       String?      @unique
  email          String?      @unique
  googleName     String?
  avatar         String?
  characterName  String?
  characterClass String?
  role           String       @default("player") // 'player' | 'moderator' | 'admin'
  lastLoginAt    DateTime?
  lastSeenAt     DateTime?
  bannedUntil    DateTime?
  banReason      String?
  createdAt      DateTime     @default(now())
  stats          Stats?
  houseMember    HouseMember?
  inventory      Inventory[]
  listings       Listing[]
  userSkills     UserSkill[]
  combatSession  CombatSession?
  activityLogs   ActivityLog[]
  feedback       Feedback[]
}

// ─── Admin / moderation ───────────────────────────────────────────────────────

model ErrorLog {
  id        Int      @id @default(autoincrement())
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  category  String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
}

model Announcement {
  id        Int       @id @default(autoincrement())
  message   String
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  category  String   // 'training' | 'raid' | 'monster' | 'inventory' | 'level' | 'status' | 'travel'
  message   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Admin-only audit trail. Deliberately no foreign keys so rows survive user deletion.
model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     // actor (null for anonymous/system events)
  targetUserId Int?     // other player affected (PvP, market)
  action       String   // e.g. 'auth.login', 'market.buy', 'raid.player'
  metadata     Json?    // event-specific details (amounts, item ids, outcome)
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model Stats {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user User @relation(fields: [userId], references: [id])

  level      Int @default(1)
  xp         Int @default(0)
  statPoints Int @default(0)

  strength     Int @default(0)
  defense      Int @default(0)
  speed        Int @default(0)
  dexterity    Int @default(0)
  intelligence Int @default(0)

  health    Int @default(100)
  maxHealth Int @default(100)
  energy    Int @default(100)
  maxEnergy Int @default(100)

  gold Int @default(0)

  hasWagon Boolean @default(false)
  wagonTier Int @default(0)
  currentCityId String?

  // NEW — travel in progress
  travelDestinationId String?
  travelArrivalAt     DateTime?

  // Real, server-tracked travel — travelArrivesAt is the source of truth for
  // when the trip ends.
  travelDestination String?
  travelStartedAt   DateTime?
  travelArrivesAt   DateTime?

  lastStrengthTrain DateTime?
  lastDefenseTrain  DateTime?
  lastSpeedTrain    DateTime?
  lastDexTrain      DateTime?

  inJail        Boolean   @default(false)
  jailUntil     DateTime?
  inHospital    Boolean   @default(false)
  hospitalUntil DateTime?
  lastEnergyAt  DateTime?

  lastRaidVillageAt  DateTime?
  lastRaidCaravanAt  DateTime?
  lastRaidManorAt    DateTime?
  lastRaidTreasuryAt DateTime?
}

model UserSkill {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  skillKey   String
  unlockedAt DateTime @default(now())

  @@unique([userId, skillKey])
}

model House {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  motto     String        @default("Strength through unity.")
  gold      Int           @default(0)
  leaderId  Int           @unique
  createdAt DateTime      @default(now())
  members   HouseMember[]
}

model HouseMember {
  id      Int    @id @default(autoincrement())
  userId  Int    @unique
  houseId Int
  rank    String @default("Bannerman")
  user    User   @relation(fields: [userId], references: [id])
  house   House  @relation(fields: [houseId], references: [id])
}

model Item {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  type        String
  effect      String
  basePrice   Int
  icon        String      @default("/assets/items/_fallback/default-item.png")
  listings    Listing[]
  inventory   Inventory[]
}

model Inventory {
  id       Int  @id @default(autoincrement())
  userId   Int
  itemId   Int
  quantity Int  @default(1)
  user     User @relation(fields: [userId], references: [id])
  item     Item @relation(fields: [itemId], references: [id])
}

model Listing {
  id        Int      @id @default(autoincrement())
  sellerId  Int
  itemId    Int
  price     Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  seller    User     @relation(fields: [sellerId], references: [id])
  item      Item     @relation(fields: [itemId], references: [id])
}

model CombatSession {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id])

  zoneId           String
  monsterName      String
  monsterLevel     Int
  monsterMaxHealth Int
  monsterHealth    Int
  monsterAttack    Int
  monsterDefense   Int

  turnCount        Int      @default(0)
  createdAt        DateTime @default(now())
}

// Hourly per-player gold snapshots (pruned after 14 days). Powers the admin
// economy view: gold in circulation over time and biggest recent gold gains.
model GoldSnapshot {
  id      Int      @id @default(autoincrement())
  userId  Int
  gold    Int
  takenAt DateTime

  @@index([takenAt])
  @@index([userId, takenAt])
}

// Login sessions. Created and managed by connect-pg-simple (see server.js), not by game code.
// Declared here only so Prisma knows the table exists and doesn't treat it as drift.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
